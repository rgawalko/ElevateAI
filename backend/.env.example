# Database Configuration
DATABASE_URL=postgresql://username:password@localhost:5432/elevate_ai

# JWT Configuration
JWT_SECRET_KEY=your-super-secret-jwt-key-here
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=30
JWT_REFRESH_TOKEN_EXPIRE_DAYS=7

# Azure OpenAI Configuration
AZURE_OPENAI_ENDPOINT=https://your-resource-name.openai.azure.com/
AZURE_OPENAI_API_KEY=your-azure-openai-api-key-here
AZURE_OPENAI_DEPLOYMENT_NAME=gpt-4

# Alternative: Use Azure Managed Identity (comment out API_KEY if using this)
# AZURE_CLIENT_ID=your-managed-identity-client-id
# AZURE_CLIENT_SECRET=your-managed-identity-client-secret
# AZURE_TENANT_ID=your-azure-tenant-id

# Application Configuration
DEBUG=True
LOG_LEVEL=INFO

# CORS Configuration
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5173,http://localhost:5174,http://localhost:5175

# API Configuration
API_V1_PREFIX=/api/v1
PROJECT_NAME=Elevate AI
VERSION=1.0.0
